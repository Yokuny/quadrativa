{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY}"
      }
    },
    "asaas": {
      "type": "http",
      "url": "https://docs.asaas.com/mcp",
      "headers": {
        "access_token": "${ASAAS_API_KEY}"
      }
    },
    "excalidraw": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-excalidraw-server@2.2.0"
      ]
    }
  }
}
